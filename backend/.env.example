ENVIRONMENT=development

# Supabase → Project Settings → Database → Connection string → "Session pooler" (porta 5432)
# (o pooler em modo transação, porta 6543, exige DB_STATEMENT_CACHE_SIZE=0)
DATABASE_URL=postgresql://postgres.<project-ref>:<senha-do-banco>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_STATEMENT_CACHE_SIZE=100

# Supabase Auth — validação de JWT (Project Settings → API / JWT Keys)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CORS_ORIGINS=http://localhost:5173
